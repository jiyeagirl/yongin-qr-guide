        "message": "<Mascot> pose must be one of 'front' | 'hello' | 'thumbsup' | 'excited' | 'curious' | 'surprised' | 'shy' | 'back' | 'glance' | 'sorry' | 'balloon' | 'thanks' | 'answer' | 'angry'."
      },
