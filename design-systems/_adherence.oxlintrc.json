        "selector": "JSXOpeningElement[name.name='FacilityIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<FacilityIcon> doesn't accept that prop. Declared props: type, size, emphasis, style."
      },
