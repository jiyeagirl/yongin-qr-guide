        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|tag|icon|iconTint|trailing|divider|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, meta, tag, icon, iconTint, trailing, divider, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:anchorLabel|clusters|pins|bottomPad|note|style|key|ref|className|style|children)$/]",
        "message": "<MapCanvas> doesn't accept that prop. Declared props: anchorLabel, clusters, pins, bottomPad, note, style."
