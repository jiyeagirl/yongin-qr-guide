        "selector": "JSXOpeningElement[name.name='FacilityIcon'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:aed|toilet|rest|shelter)$/]",
        "message": "<FacilityIcon> type must be one of 'aed' | 'toilet' | 'rest' | 'shelter'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:bottom|hidden|items|style|key|ref|className|style|children)$/]",
        "message": "<FloatingControls> doesn't accept that prop. Declared props: bottom, hidden, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|size|variant|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, size, variant, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|soft|outline|brand)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'soft' | 'outline' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|value|onChange|placeholder|type|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, value, onChange, placeholder, type, disabled, style."
      },
