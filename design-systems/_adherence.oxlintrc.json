      {
        "selector": "JSXOpeningElement[name.name='ContextBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|label|note|leading|onReset|style|key|ref|className|style|children)$/]",
        "message": "<ContextBar> doesn't accept that prop. Declared props: place, label, note, leading, onReset, style. (place 를 넘기지 않으면 안내 문장 한 줄짜리 얇은 띠가 된다)"
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|pose|base|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, action, pose, base, style."
      },
